# Copy this file to .env and fill in real values. .env is gitignored.
# Defaults below match the dev fallbacks in application.properties and
# docker-compose.yml so local development works without any overrides.

# PostgreSQL (used by docker-compose and the backend)
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow123
POSTGRES_DB=taskflow

# Backend JDBC URL -- point at the compose service name (db) when running
# inside Docker, or at localhost for host-side development.
DB_URL=jdbc:postgresql://localhost:5432/taskflow

# JWT signing key -- must base64-decode to at least 64 bytes (HS512).
# Generate a fresh one for any non-dev environment.
JWT_SECRET=ZmFrZS1kZXYtc2VjcmV0LW5vdC1mb3ItcHJvZHVjdGlvbi1wbGVhc2UtcmVwbGFjZS1tZQ==
JWT_EXPIRATION_MS=86400000
